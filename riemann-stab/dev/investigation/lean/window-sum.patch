 #print axioms block_energy
+#print axioms windowSum_of_cert
+#print axioms windowSum_of_telescoping
+#print axioms block_energy_of_windowSum
+#print axioms block_energy'
+#print axioms sum_shift_sub_telescope
+#print axioms sum_shift_sub_le
 
 end Zeta23Ext.Bridge
