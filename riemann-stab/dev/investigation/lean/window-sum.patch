+/-- **The `n`-point bound with a signed endpoint term.**  A telescoping certificate with state
+potential `Ψ` taking values in `[lo, hi]`, under the cap `c(m−(n−1)) + (hi − lo) ≤ 1`, gives the
+same constant `Phi_n n c m p` as the per-block theorem — no `B/W` is paid.  `hcob` is the
+certificate: not a theorem of Lean, but what an exhaustive interval subdivision claims. -/
+theorem n_point_bound_signed (n : ℕ) (c : ℝ) (m p : ℕ) (hn : 2 ≤ n) (hm : n ≤ m) (hp : 0 < p)
+    (hc : 0 < c)
+    (Ψ : (Fin (n - 2) → ℝ) → ℝ) (lo hi : ℝ) (hΨ : ∀ g, lo ≤ Ψ g ∧ Ψ g ≤ hi)
+    (hcob : ∀ y : Fin m → ℝ, StrictMono y → ∀ i ∈ range (m - (n - 1)),
+      c ≤ F n p (windowGaps n (sortedExt y) i)
+        + (Ψ (stateGaps n (sortedExt y) (i + 1)) - Ψ (stateGaps n (sortedExt y) i)))
+    (hcap : c * ((m : ℝ) - ((n : ℝ) - 1)) + (hi - lo) ≤ 1) :
+    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
+      (Phi_n n c m p - ε) * (Ncount T (2 * T) : ℝ) ≤ N0simple T (2 * T) := by
+  have hA0 : c * ((m : ℝ) - ((n : ℝ) - 1)) ≤ 1 := by
+    have := hΨ (fun _ => 0); linarith
+  have h := solve_linear (N := fun T => (Ncount T (2 * T) : ℝ))
+    (N0 := fun T => (N0simple T (2 * T) : ℝ)) hn hm hA0 (by
+      have := pre_solve_signed zetaZeroConfig paperInputs_zeta hn hm hp hc Ψ lo hi hΨ hcob hcap
+      simpa only [zetaZeroConfig_N, zetaZeroConfig_N0s] using this)
+  intro ε hε
+  exact eventually_atTop.mp (h ε hε)
+
+/-- **The `sharp` chain certificate, signed form.**  With its state potential's oscillation
+`hi − lo ≤ 0.00171` and the cap `0.003956·252 + 0.00171 = 0.998622 ≤ 1`, the certificate
+`R ≥ 0.003956` on every window of every sorted 258-point list gives
+`Phi_n 7 (3956/10⁶) 258 3000 = 0.6731093501…` — the naive projection, with no endpoint penalty.
+`hcob` is what the rigorous sweep claims; `hΨ`/`hB` are the exact oscillation of the shipped
+coefficients (`dev/investigation/endpoint_oscillation.py`). -/
+theorem sharp_chain_bound_signed (Ψ : (Fin 5 → ℝ) → ℝ) (lo hi : ℝ)
+    (hΨ : ∀ g, lo ≤ Ψ g ∧ Ψ g ≤ hi) (hB : hi - lo ≤ 171 / 100000)
+    (hcob : ∀ y : Fin 258 → ℝ, StrictMono y → ∀ i ∈ range 252,
+      3956 / 1000000 ≤ F 7 3000 (windowGaps 7 (sortedExt y) i)
+        + (Ψ (stateGaps 7 (sortedExt y) (i + 1)) - Ψ (stateGaps 7 (sortedExt y) i))) :
+    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
+      (Phi_n 7 (3956 / 1000000) 258 3000 - ε) * (Ncount T (2 * T) : ℝ)
+        ≤ N0simple T (2 * T) :=
+  n_point_bound_signed 7 (3956 / 1000000) 258 3000 (by norm_num) (by norm_num) (by norm_num)
+    (by norm_num) Ψ lo hi hΨ hcob (by norm_num; linarith [hB])
+
+end Analytic
