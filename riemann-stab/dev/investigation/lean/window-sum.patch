+/-! ### The window-sum hypothesis, and the same bound from it
+
+`block_energy` consumes the per-window certificate `hCert` in exactly one way: summed over the
+`m − (n−1)` consecutive windows of the sorted block (`hsum` in its proof).  The bound is
+therefore available under the weaker hypothesis that the window sum itself is bounded below,
+which is what a telescoping (coboundary) certificate delivers once its endpoint loss is paid.
+Nothing here changes `block_energy`; it is re-derived at the end as a regression. -/
+
+/-- The window-sum certificate at a fixed block length `m`: over every strictly increasing
+`m`-point list, the `n`-point functional summed over its `m − (n−1)` consecutive windows is at
+least `c(m − (n−1))`. -/
+def WindowSumCert (n p m : ℕ) (c : ℝ) : Prop :=
+  ∀ y : Fin m → ℝ, StrictMono y →
+    c * ((m : ℝ) - ((n : ℝ) - 1))
+      ≤ ∑ i ∈ range (m - (n - 1)), F n p (windowGaps n (sortedExt y) i)
+
+/-- A per-window certificate implies the window-sum certificate at every `m ≥ n`. -/
+theorem windowSum_of_cert {c : ℝ} {n p m : ℕ} (hn : 2 ≤ n) (hm : n ≤ m)
+    (hCert : ∀ g : Fin (n - 1) → ℝ, (∀ i, 0 ≤ g i) → c ≤ F n p g) :
+    WindowSumCert n p m c := by
+  intro y hymono
+  have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (by omega : 1 ≤ n)
+  have hcastn : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
+    rw [Nat.cast_sub (by omega : 1 ≤ n)]; norm_num
+  have hwin : ∀ i ∈ range (m - (n - 1)), c ≤ F n p (windowGaps n (sortedExt y) i) := by
+    intro i hi
+    rw [mem_range] at hi
+    apply hCert
+    intro j
+    have hj := j.2
+    have hlt : i + ((j : ℕ) + 1) < m := by omega
+    exact sub_nonneg.mpr (sortedExt_mono hymono (by omega) hlt)
+  have h := sum_le_sum hwin
+  rw [sum_const, card_range, nsmul_eq_mul] at h
+  have hcast : ((m - (n - 1) : ℕ) : ℝ) = (m : ℝ) - ((n : ℝ) - 1) := by
+    rw [Nat.cast_sub (by omega : n - 1 ≤ m), hcastn]
+  rw [hcast] at h
+  linarith
+
+/-- **The telescoping adapter.**  A coboundary certificate `c ≤ F(window i) + φ(i+1) − φ(i)` on
+every window of every sorted `m`-point list, whose endpoint loss `φ(W) − φ(0)` is at most `B`
+(`W = m − (n−1)`), gives the window-sum certificate at `c − B/W`.  The endpoint loss, not the
+single-edge amplitude used by a tail lemma, is what has to be bounded here. -/
+theorem windowSum_of_telescoping {c B : ℝ} {n p m : ℕ} (hn : 2 ≤ n) (hm : n ≤ m)
+    (φ : (Fin m → ℝ) → ℕ → ℝ)
+    (hcob : ∀ y : Fin m → ℝ, StrictMono y → ∀ i ∈ range (m - (n - 1)),
+      c ≤ F n p (windowGaps n (sortedExt y) i) + (φ y (i + 1) - φ y i))
+    (hB : ∀ y : Fin m → ℝ, StrictMono y → φ y (m - (n - 1)) - φ y 0 ≤ B) :
+    WindowSumCert n p m (c - B / ((m : ℝ) - ((n : ℝ) - 1))) := by
+  intro y hy
+  have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (by omega : 1 ≤ n)
+  have hcastn : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
+    rw [Nat.cast_sub (by omega : 1 ≤ n)]; norm_num
+  have hcast : ((m - (n - 1) : ℕ) : ℝ) = (m : ℝ) - ((n : ℝ) - 1) := by
+    rw [Nat.cast_sub (by omega : n - 1 ≤ m), hcastn]
+  have hWpos : (0 : ℝ) < (m : ℝ) - ((n : ℝ) - 1) := by
+    rw [← hcast]; exact_mod_cast (by omega : 0 < m - (n - 1))
+  have h := sum_le_sum (hcob y hy)
+  rw [sum_const, card_range, nsmul_eq_mul, sum_add_distrib, sum_range_sub, hcast] at h
+  have hB' := hB y hy
+  rw [sub_mul, div_mul_cancel₀ _ hWpos.ne']
+  linarith
+
+theorem block_energy_of_windowSum {c : ℝ} {n p : ℕ} (hn : 2 ≤ n) (hp : 0 < p)
+    {m : ℕ} (hSum : WindowSumCert n p m c) (hm : n ≤ m) (hcard : Fintype.card ι = m) (x : ι → ℝ) (hx : Function.Injective x) :
+    c * ((m : ℝ) - ((n : ℝ) - 1))
+      ≤ energyOn x univ + (((n : ℝ) - 1) / (p : ℝ)) * spanOf x univ := by
+  classical
+  -- sort the points
+  have hS : (univ.image x).card = m := by
+    rw [card_image_of_injective _ hx, card_univ, hcard]
+  set y : Fin m → ℝ := ⇑((univ.image x).orderEmbOfFin hS) with hydef
+  have hymem : ∀ k, y k ∈ univ.image x := fun k => Finset.orderEmbOfFin_mem _ hS k
+  have hymono : StrictMono y := ((univ.image x).orderEmbOfFin hS).strictMono
+  set Y := sortedExt y with hYdef
+  have hm0 : 0 < m := by omega
+  have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (by omega : 1 ≤ n)
+  have hcastn : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
+    rw [Nat.cast_sub (by omega : 1 ≤ n)]; norm_num
+  -- the window sum is the hypothesis
+  have hsum := hSum y hymono
+  rw [← hYdef] at hsum
+  simp_rw [F_windowGaps] at hsum
+  rw [sum_add_distrib, ← mul_sum] at hsum
+  -- the linear term: each single gap is charged at most `n − 1` times
+  have hlin : ∑ i ∈ range (m - (n - 1)), (Y (i + (n - 1)) - Y i)
+      ≤ ((n : ℝ) - 1) * spanOf x univ := by
+    rw [sum_shift_sub]
+    have hterm : ∀ i ∈ range (n - 1), Y (m - (n - 1) + i) - Y i ≤ Y (m - 1) - Y 0 := by
+      intro i hi
+      rw [mem_range] at hi
+      have h1 := sortedExt_mono hymono (a := m - (n - 1) + i) (b := m - 1) (by omega) (by omega)
+      have h2 := sortedExt_mono hymono (a := 0) (b := i) (by omega) (by omega)
+      linarith
+    have hspan : Y (m - 1) - Y 0 ≤ spanOf x univ := by
+      obtain ⟨i₀, -, hi₀⟩ := mem_image.mp (hymem ⟨m - 1, by omega⟩)
+      obtain ⟨j₀, -, hj₀⟩ := mem_image.mp (hymem ⟨0, hm0⟩)
+      rw [hYdef, sortedExt_of_lt y (by omega : m - 1 < m), sortedExt_of_lt y hm0, ← hi₀, ← hj₀]
+      exact (le_abs_self _).trans (abs_sub_le_spanOf x (mem_univ i₀) (mem_univ j₀))
+    calc ∑ i ∈ range (n - 1), (Y (m - (n - 1) + i) - Y i)
+        ≤ ∑ i ∈ range (n - 1), (Y (m - 1) - Y 0) := sum_le_sum hterm
+      _ = ((n : ℝ) - 1) * (Y (m - 1) - Y 0) := by
+          rw [sum_const, card_range, nsmul_eq_mul, hcastn]
+      _ ≤ ((n : ℝ) - 1) * spanOf x univ := by nlinarith
+  -- the quadratic term
+  have hquad := window_pairs_le_energy hn hm x hx hS
+  simp only [pairCoef] at hquad
+  rw [← hydef, ← hYdef] at hquad
+  have hp' : 0 ≤ 1 / (p : ℝ) := by positivity
+  calc c * ((m : ℝ) - ((n : ℝ) - 1))
+      ≤ _ := hsum
+    _ ≤ (1 / (p : ℝ)) * (((n : ℝ) - 1) * spanOf x univ) + energyOn x univ := by
+        gcongr
+    _ = energyOn x univ + (((n : ℝ) - 1) / (p : ℝ)) * spanOf x univ := by ring
+
+
+/-- Regression: `block_energy` follows from the window-sum form. -/
+theorem block_energy' {c : ℝ} {n p : ℕ} (hn : 2 ≤ n) (hp : 0 < p)
+    (hCert : ∀ g : Fin (n - 1) → ℝ, (∀ i, 0 ≤ g i) → c ≤ F n p g)
+    {m : ℕ} (hm : n ≤ m) (hcard : Fintype.card ι = m) (x : ι → ℝ) (hx : Function.Injective x) :
+    c * ((m : ℝ) - ((n : ℝ) - 1))
+      ≤ energyOn x univ + (((n : ℝ) - 1) / (p : ℝ)) * spanOf x univ :=
+  block_energy_of_windowSum hn hp (windowSum_of_cert hn hm hCert) hm hcard x hx
+
